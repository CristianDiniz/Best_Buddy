# ==============================================================
# BEST BUDDY - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================

# Segurança básica do Django
SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-aqui
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,seusite.com,api.seusite.com

# CORS (origens do frontend autorizadas a chamar a API)
CORS_ALLOWED_ORIGINS=https://seusite.com,http://localhost:5500,http://127.0.0.1:5500

# Banco de Dados (MySQL)
USE_MYSQL=True
DB_NAME=bestbuddy_db
DB_USER=bestbuddy_user
DB_PASSWORD=sua_senha_forte_aqui
DB_HOST=db
DB_PORT=3306

# E-mail Transacional (SMTP para recuperação de senhas)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.provedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@seusite.com
EMAIL_HOST_PASSWORD=sua_senha_de_app
DEFAULT_FROM_EMAIL=Best Buddy <no-reply@seusite.com>

# Twilio (Validação de WhatsApp real)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_MOCK_DEV=False

# Cabeçalhos HTTPS em Produção (ativados por padrão quando DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
